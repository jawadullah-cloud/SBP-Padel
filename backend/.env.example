ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./sbp_padel.db
REDIS_URL=
REDIS_REQUIRED=false
TIMEZONE=Asia/Karachi
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10080
SERVICE_FEE=100
SLOT_HOLD_MINUTES=10
PASSWORD_RESET_MINUTES=10

# Email password recovery. Gmail/Outlook SMTP can be used for development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Production examples:
# DATABASE_URL=postgresql+asyncpg://sbp_padel:change-me@localhost:5432/sbp_padel
# REDIS_URL=redis://localhost:6379/0
# REDIS_REQUIRED=true

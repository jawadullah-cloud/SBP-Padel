# SBP-Padel production environment template
# Copy values into your deployment secret/config store. Do not commit real secrets.

ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DB_HOST:5432/sbp_padel
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=https://admin.example.gov.pk,https://player.example.gov.pk
TRUSTED_HOSTS=api.example.gov.pk

# Redis is optional in code today. If production architecture requires it, make that explicit.
REDIS_REQUIRED=false
REDIS_URL=

TIMEZONE=Asia/Karachi
ACCESS_TOKEN_MINUTES=10080
SLOT_HOLD_MINUTES=10
PASSWORD_RESET_MINUTES=10
SERVICE_FEE=100

# Required in production because password recovery is a public feature.
SMTP_HOST=smtp.example.gov.pk
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.gov.pk
SMTP_STARTTLS=true

# Deferred until Google sign-in is intentionally enabled.
GOOGLE_CLIENT_ID=

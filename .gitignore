# Backend secrets and local databases
backend/.env
backend/.env.*
!backend/.env.production.example
backend/*.db
backend/*.db-*

# Python caches, coverage and environments
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
*.pyc
.coverage
coverage.xml
htmlcov/
.venv/
venv/

# Admin dependencies/build/test output
admin/node_modules/
admin/.next/
admin/playwright-report/
admin/test-results/
admin/coverage/

# Android generated/signing material. The committed dev-signing-key.b64 is a
# disposable debug fixture; real release keys must never be committed.
android/*.keystore
android/*.jks
android/*.p12
android/key.properties
android/local.properties
android/.gradle/
android/**/build/

# General local environment files
.env
.env.*
!.env.example

# Local logs and editor/OS metadata
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
